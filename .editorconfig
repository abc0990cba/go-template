# Editor defaults; CI owns the deep checks (gofmt, oxlint, oxfmt, vacuum).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[*.{md,yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{nomad.hcl,hcl,j2}]
indent_size = 2

[*.sql]
indent_size = 2
