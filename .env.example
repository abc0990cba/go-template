# Copy to .env and adjust. The app reads these variables directly; docker
# compose uses the `env_file`/environment mapping you configure.

# HTTP server
APP_HTTP_ADDR=:8080
APP_BASE_URL=http://localhost:8080

# Logging: debug | info | warn | error; format: text | json
APP_LOG_LEVEL=info
APP_LOG_FORMAT=text

# OpenTelemetry OTLP/HTTP endpoint for traces, e.g. localhost:4318.
# Empty disables tracing. APP_OTLP_SAMPLER is the head-sampling ratio in
# (0..1]: 1 keeps every trace (dev), 0.1 keeps every tenth (production
# traffic). APP_PYROSCOPE_URL enables continuous profiling when the
# observability profile is up (pyroscope:4040 inside compose).
# APP_PPROF=1 mounts /debug/pprof.
APP_OTLP_ENDPOINT=
APP_OTLP_SAMPLER=1
APP_PYROSCOPE_URL=
APP_PPROF=0

# Reliability
APP_SHUTDOWN_TIMEOUT=10s
APP_EXTERNAL_TIMEOUT=3s
APP_MAX_CONCURRENCY=8

# Storage: PostgreSQL URL. Empty keeps the in-memory development store.
# Sensitive values may instead come from a mounted secret file:
# APP_DATABASE_URL_FILE points at a file whose contents are the URL
# (Docker/K8s secrets); setting both the direct value and _FILE fails.
APP_DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# PostgreSQL connection pool (pgx). Zero values keep the driver defaults.
# The statement/idle-tx timeouts are enforced server-side by Postgres and
# protect the pool from runaway queries; migrations are exempt.
APP_PG_MAX_CONNS=20
APP_PG_MIN_CONNS=2
APP_PG_CONN_MAX_LIFETIME=30m
APP_PG_CONN_MAX_IDLE_TIME=5m
APP_PG_HEALTH_CHECK_PERIOD=1m
APP_PG_STATEMENT_TIMEOUT=30s
APP_PG_IDLE_TX_TIMEOUT=60s

# Analytics warehouse (optional; empty disables event persistence)
APP_CLICKHOUSE_ADDR=localhost:9000
APP_CLICKHOUSE_DB=app
APP_CLICKHOUSE_USER=default
APP_CLICKHOUSE_PASSWORD=

# Queue: Redis address. Empty keeps jobs in-process (development mode).
# APP_REPORT_CRON schedules a periodic report job; empty disables it.
APP_REDIS_ADDR=localhost:6379
APP_REPORT_CRON=0 3 * * *

# JWT token grants for non-browser clients (opt-in). Without a secret the
# /api/auth/token endpoints answer 501. Minimum 32 bytes; supports the
# APP_JWT_SECRET_FILE mounted-secret pattern.
APP_JWT_SECRET=
APP_JWT_ACCESS_TTL=15m
APP_JWT_REFRESH_TTL=720h

# Sessions and cookies
APP_SESSION_TTL=168h
# Secure cookies require https (browsers allow them on localhost too);
# set 0 only for plain http outside localhost.
APP_COOKIE_SECURE=1

# Auth rate limiting (token bucket per IP)
APP_AUTH_RATE_RPS=5
APP_AUTH_RATE_BURST=10

# Demo account seeded at api startup when set (development convenience;
# leave empty in production)
APP_DEMO_EMAIL=demo@go-template.local
APP_DEMO_PASSWORD=demo-password-123
# Seed the richer demo dataset (120 users, jobs, reports, event history) at
# api startup; requires APP_DATABASE_URL. Idempotent: skips when present.
APP_DEMO_SEED=1

# OAuth providers (optional; linking requires an active session)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
OAUTH_STATE_TTL=10m
# Endpoint overrides for tests against a mock provider:
GOOGLE_AUTH_URL=
GOOGLE_TOKEN_URL=
GOOGLE_USERINFO_URL=
GITHUB_AUTH_URL=
GITHUB_TOKEN_URL=
GITHUB_USER_URL=
GITHUB_EMAIL_URL=
FACEBOOK_AUTH_URL=
FACEBOOK_TOKEN_URL=
FACEBOOK_USERINFO_URL=
TWITTER_AUTH_URL=
TWITTER_TOKEN_URL=
TWITTER_USERINFO_URL=

# Transactional email. Without APP_SMTP_HOST the app logs messages instead
# of sending; docker-compose ships Mailpit (read mail at http://localhost:8025).
# APP_SMTP_PASSWORD_FILE reads the password from a mounted secret file.
APP_SMTP_HOST=
APP_SMTP_PORT=1025
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
APP_SMTP_FROM=no-reply@go-template.local

# Email transport: "sync" sends inline before the triggering request
# returns; "queue" records the message and the worker delivers it with
# retries and backoff (requires APP_REDIS_ADDR). Both record every message
# in the delivery log (GET /api/emails for admins). Requires SMTP (or logs)
# regardless — the queue only moves WHO sends, not WHETHER mail is sent.
APP_EMAIL_MODE=sync
# Retention for the delivery log; the worker sweeps older rows hourly.
APP_EMAIL_RETENTION=720h

# Audit trail retention. Entries are append-only and DB-enforced (no
# UPDATE/DELETE for the app role); the worker prunes through the
# audit_prune function on this schedule. 0 keeps entries forever.
APP_AUDIT_RETENTION=8760h

# JWT key rotation: point this at a mounted file with a kid→secret map to
# roll signing secrets without invalidating outstanding tokens:
#   {"active":"2026-10","keys":{"2026-09":"<old 32+ byte secret>","2026-10":"<new secret>"}}
# New tokens carry kid=active; old kids keep verifying until dropped from
# the file (access tokens expire in minutes anyway). Tokens minted before
# the keyset existed keep verifying against APP_JWT_SECRET while it is set.
# APP_JWT_SECRETS_FILE=

# --- Event streams: user enrichment from Kafka + NATS -----------------------
# Both are optional; an empty value disables that side (consumers, health
# probes, and the outbox relay degrade to off with a startup warning).
# docker-compose.brokers.yml starts Redpanda (Kafka API) and NATS JetStream.
# Host-side tools (cmd/devtools) reach Redpanda on localhost:19092; the
# containers use redpanda:9092 internally.
APP_KAFKA_BROKERS=localhost:19092
APP_KAFKA_TOPIC_PROFILE=user-profile.v1
APP_KAFKA_TOPIC_EVENTS=user-events.v1
APP_KAFKA_GROUP=go-template-enricher
APP_NATS_URL=
APP_NATS_STREAM=USERS
APP_NATS_SUBJECT_CONTACT=users.contact.v1
APP_NATS_SUBJECT_EVENTS=users.events.v1
APP_NATS_DURABLE=enricher-contact

# Circuit breakers wrap outbound calls (enrichment HTTP, webhooks, broker
# publishes). Threshold = consecutive failures before opening; open timeout
# is the cool-down before the half-open probe.
APP_CB_FAILURE_THRESHOLD=5
APP_CB_OPEN_TIMEOUT=30s

# Bulkheads bound concurrent calls per outbound dependency (enrichment,
# webhooks). A full bulkhead rejects fast (backpressure) instead of stacking
# goroutines behind a slow dependency; rejections never trip the breaker.
APP_BULKHEAD_LIMIT=16
APP_BULKHEAD_ACQUIRE_TIMEOUT=1s

# Worker metrics listener: stream, relay, and dead-letter gauges live in the
# worker process, so it serves its own /metrics when this is set.
APP_METRICS_ADDR=

# Transactional outbox relay (worker): drain interval, batch size, and the
# attempt budget before an event lands in dead letters.
APP_OUTBOX_INTERVAL=1s
APP_OUTBOX_BATCH=100
APP_OUTBOX_MAX_ATTEMPTS=10

# Rate limiting: the /api-wide per-IP budget (the auth budget above is much
# tighter). Backed by Redis when APP_REDIS_ADDR is set, in-memory otherwise.
APP_API_RATE_RPS=50
APP_API_RATE_BURST=100

# Per-principal budget on top of the per-IP budget: authenticated requests
# are keyed by user id (or API-key subject), so one hot account cannot
# exhaust the budget shared by everyone behind one NAT IP.
APP_USER_RATE_RPS=100
APP_USER_RATE_BURST=200

# API idempotency keys: how long stored responses stay replayable.
APP_IDEMPOTENCY_TTL=24h

# Breached-password checks against the Have I Been Pwned corpus via the
# k-anonymity range API (only a 5-char SHA-1 prefix of the password ever
# leaves the process). "warn" logs compromised passwords and allows them;
# "enforce" rejects them at registration and password reset; checks fail
# open when the API is unreachable. Off by default.
APP_HIBP_MODE=off
# APP_HIBP_URL=https://api.pwnedpasswords.com

# Progressive lockout: after APP_LOCKOUT_THRESHOLD wrong passwords the
# account locks for APP_LOCKOUT_WINDOW, doubling per further failure up to
# a 24h cap; a successful login or password reset clears it, admins can
# unlock via POST /api/users/{id}/unlock. 0 disables the feature. Login
# answers identically for locked and wrong-password accounts.
APP_LOCKOUT_THRESHOLD=5
APP_LOCKOUT_WINDOW=15m

# Runtime contract enforcement on /api: requests are validated against the
# embedded OpenAPI spec (the same file /openapi.yaml serves). "off" disables
# the gate, "requests" rejects non-conforming requests with 400 problem+json,
# "all" additionally validates responses (mismatches are logged, never
# altered). CI contract tests keep handlers conformant; this gate extends
# that guarantee to traffic the tests never saw.
APP_OPENAPI_VALIDATION=requests

# Load shedding: cap on concurrent /api requests. Bulk surfaces (reports,
# analytics, exports) are shed at 3/4 of the cap, keeping a reserve lane for
# interactive traffic; saturated requests get 503 + Retry-After. 0 disables.
APP_LOADSHED_MAX_INFLIGHT=512

# Per-request context deadline on /api (streaming and file transfers are
# exempt). The deadline propagates to database and queue calls, so a wedged
# backend surfaces as a fast 504 instead of a hung connection. 0 disables.
APP_REQUEST_TIMEOUT=30s

# Retention: the exactly-once inbox (processed_events) doubles as the dedupe
# table; rows older than this window are swept by the worker. Keep it longer
# than any redelivery delay your brokers can produce. Export ZIPs expire
# after 7 days (docs/data-export.md); ClickHouse events carry a 90-day TTL
# (migrations/clickhouse/002_events_ttl.sql).
APP_RETENTION_PROCESSED_EVENTS=720h

# --- File storage ------------------------------------------------------------
# Without APP_S3_BUCKET uploads land in the in-process store (dev only; a
# restart loses them). With it, blobs go to S3/MinIO — `--profile files`
# starts MinIO on localhost:19000 (console :19001), the app reaches it at
# minio:9000 inside compose. Secrets accept the _FILE pattern.
APP_S3_ENDPOINT=
APP_S3_REGION=us-east-1
APP_S3_BUCKET=
APP_S3_ACCESS_KEY_ID=
APP_S3_SECRET_ACCESS_KEY=
APP_S3_USE_PATH_STYLE=1
APP_FILES_MAX_MB=10
