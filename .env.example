# Copy to .env and adjust. The app reads these variables directly; docker
# compose uses the `env_file`/environment mapping you configure.

# HTTP server
APP_HTTP_ADDR=:8080
APP_BASE_URL=http://localhost:8080

# Logging: debug | info | warn | error; format: text | json
APP_LOG_LEVEL=info
APP_LOG_FORMAT=text

# OpenTelemetry OTLP/HTTP endpoint for traces, e.g. localhost:4318.
# Empty disables tracing. APP_PPROF=1 mounts /debug/pprof.
APP_OTLP_ENDPOINT=
APP_PPROF=0

# Reliability
APP_SHUTDOWN_TIMEOUT=10s
APP_EXTERNAL_TIMEOUT=3s
APP_MAX_CONCURRENCY=8

# Storage: PostgreSQL URL. Empty keeps the in-memory development store.
APP_DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# Queue: Redis address. Empty keeps jobs in-process (development mode).
# APP_REPORT_CRON schedules a periodic report job; empty disables it.
APP_REDIS_ADDR=localhost:6379
APP_REPORT_CRON=0 3 * * *

# OAuth providers (optional; required once OAuth login is wired)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_STATE_TTL=10m
