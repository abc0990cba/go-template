# =============================================================================
# SECRETS TEMPLATE — the real file (secrets.yml) is ansible-vault encrypted
# and generated automatically by `make vps-setup`. Never commit secrets.yml.
# This example documents every key the playbooks read. Empty keys are valid:
# the matching feature stays off.
# =============================================================================
secrets:
  # --- Core (always required; auto-generated by vps-setup) ---
  postgres_password: "change-me"          # Postgres superuser + app DB owner
  jwt_secret: "change-me"                 # APP_JWT_SECRET (min 32 bytes)
  grafana_admin_password: "change-me"     # Grafana admin login
  woodpecker_agent_secret: "change-me"    # shared secret server<->agent

  # --- Woodpecker GitHub forge (one-time OAuth app; docs/vps/deployment.md) ---
  woodpecker_github_client_id: ""
  woodpecker_github_client_secret: ""

  # --- Alert delivery (alert_receiver in main.yml picks which is used) ---
  telegram_bot_token: ""
  telegram_chat_id: ""
  slack_webhook_url: ""                   # used as alertmanager api_url
  alerting_smtp_host: ""
  alerting_smtp_port: "587"
  alerting_smtp_from: ""
  alerting_smtp_to: ""
  alerting_smtp_username: ""
  alerting_smtp_password: ""

  # --- App transactional email (optional; set app_smtp_host in main.yml) ---
  app_smtp_password: ""

  # --- App integrations (optional) ---
  app_oauth_google:   { client_id: "", client_secret: "" }
  app_oauth_github:   { client_id: "", client_secret: "" }
  app_oauth_facebook: { client_id: "", client_secret: "" }
  app_oauth_twitter:  { client_id: "", client_secret: "" }

  # --- Off-site backups (optional; rclone remote name + config) ---
  backup_rclone_remote: ""                # e.g. "b2:go-template-backups"
  backup_rclone_config: ""                # full rclone.conf content (multiline)
