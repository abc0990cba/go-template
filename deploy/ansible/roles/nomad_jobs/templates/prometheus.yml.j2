# Managed by Ansible — deploy/ansible/roles/nomad_jobs (rendered from
# prometheus.yml.j2). Same job names as the compose development stack
# (deploy/prometheus.yml) so the repo's alert rules and Grafana dashboards
# work unchanged; targets are this host's loopback listeners.
global:
  scrape_interval: 15s
  evaluation_interval: 30s

rule_files:
  - /conf/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["127.0.0.1:9093"]

scrape_configs:
  - job_name: go-template
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:8080"]

  # Stream consumers, the outbox relay, and dead-letter depth live in the
  # worker process; it serves its own /metrics when APP_METRICS_ADDR is set.
  - job_name: go-template-worker
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:9090"]

  # Host-level metrics (CPU, memory, disk, network) for capacity alerting.
  - job_name: node-exporter
    static_configs:
      - targets: ["127.0.0.1:9100"]

  # Synthetic outside-in check: Prometheus asks the blackbox exporter to GET
  # /health/live like a real client would — through Caddy and TLS. This is
  # the check that catches a broken front door even when whitebox metrics
  # look green.
  - job_name: blackbox-api-live
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - https://{{ app_domain }}/health/live
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:911
{% if monitoring_logs_enabled | default(true) %}
  # The log stack's own metrics: Loki ingest health and promtail's
  # read/ship positions surface log-pipeline breakage early.
  - job_name: loki
    static_configs:
      - targets: ["127.0.0.1:3100"]
  - job_name: promtail
    static_configs:
      - targets: ["127.0.0.1:9080"]
{% endif %}
}
