[Unit]
Description=Nomad (single-node server + client)
Documentation=https://developer.hashicorp.com/nomad/docs
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
ExecStart=/usr/local/bin/nomad agent -config=/etc/nomad.d
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
# Nomad manages Docker containers and writes under /opt — keep unit sandboxing light.
KillMode=process
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
