# CI deploy policy: everything the Woodpecker pipeline needs — submit the app
# job (blocking `nomad job run` gates on the deployment health), read status —
# nothing else. Capability names validated against Nomad 2.0.7.
# Used by the "deploy.token" (see docs/vps/deployment.md).
namespace "*" {
  capabilities = [
    "submit-job",
    "read-job",
    "list-jobs",
  ]
}

node {
  policy = "read"
}

agent {
  policy = "read"
}
